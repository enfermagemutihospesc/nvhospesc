// ════════════════════════════════════════════════════════════════════════════
// REGRAS DO FIRESTORE – trecho da BUSCA ATIVA NSP / CCIH
// Projeto: evolucaouti (o mesmo do sistema da UTI)
//
// NÃO substitua as regras atuais da UTI. No console do Firebase
// (Firestore Database → Regras), cole as funções e os blocos "match" abaixo
// DENTRO do bloco "match /databases/{database}/documents { ... }" que já existe,
// e clique em Publicar.
// ════════════════════════════════════════════════════════════════════════════

    // ── Busca ativa NSP/CCIH ──────────────────────────────────────────────────
    // Mantenha esta lista igual a ADMIN_EMAILS do config.js
    function nspAdminsFixos() { return ['tercio@hospesc.com.br']; }
    function nspEmail() { return request.auth.token.email.lower(); }
    function nspPerfil() { return /databases/$(database)/documents/usuarios_nsp/$(nspEmail()); }
    function nspAdmin() {
      return request.auth != null && (nspEmail() in nspAdminsFixos()
        || (exists(nspPerfil()) && get(nspPerfil()).data.role == 'admin' && get(nspPerfil()).data.ativo == true));
    }
    function nspAtivo() {
      return request.auth != null && (nspEmail() in nspAdminsFixos()
        || (exists(nspPerfil()) && get(nspPerfil()).data.ativo == true));
    }

    match /usuarios_nsp/{email} {
      allow read: if request.auth != null;
      allow create, delete: if nspAdmin();
      allow update: if nspAdmin()
        || (request.auth != null && nspEmail() == email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senhaTrocada']));
    }
    match /nsp_leitos/{id}     { allow read, write: if nspAtivo(); }
    match /nsp_visitas/{id}    { allow read, write: if nspAtivo(); }
    match /nsp_amostras/{id}   { allow read, write: if nspAtivo(); }
    match /nsp_config/{id}     { allow read, write: if nspAtivo(); }
    match /nsp_movimentos/{id} { allow read, create: if nspAtivo(); }
